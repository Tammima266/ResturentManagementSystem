@model ResturentManagementSystem1.Models.LoginViewModel

@{
    ViewData["Title"] = "Login - FunFood";
}

<div class="container my-5" style="max-width: 500px;">
    <div class="card shadow-sm p-4 border-0 bg-light">
        <h2 class="text-center mb-4 fw-bold text-danger">Login to FunFood 🍔</h2>
        
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-bold">Username or Email</label>
                <input asp-for="Username" class="form-control" placeholder="Enter username or email" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">Login</button>
        </form>
    </div>
</div>