@model IEnumerable<ResturentManagementSystem1.Models.Order>

@{
    ViewData["Title"] = "Manage Customer Orders - FunFood Admin";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">Live Customer Orders 📦</h2>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Back to Dashboard</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-4">
            <h4>No orders placed yet!</h4>
            <p class="mb-0">Customer orders will appear here in real-time once they check out.</p>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer Name</th>
                        <th>Delivery Address</th>
                        <th>Total (৳)</th>
                        <th>Status</th>
                        <th>Date & Time</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@item.Id</td>
                            <td>@item.CustomerName</td>
                            <td>@item.DeliveryAddress</td>
                            <td>৳@item.TotalAmount.ToString("0.00")</td>
                            <td>
                                <!-- Dynamic Badge Color Coding updated to support Delivered -->
                                <span class="badge bg-@(item.OrderStatus == "Pending" ? "warning text-dark" : item.OrderStatus == "Preparing" ? "info text-dark" : item.OrderStatus == "Ready" ? "success" : item.OrderStatus == "Delivered" ? "success" : "danger")">
                                    @item.OrderStatus
                                </span>
                            </td>
                            <td>@item.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <select name="status" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                                        <option value="" disabled selected>Update Status</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Preparing">Preparing</option>
                                        <option value="Ready">Ready</option>
                                        <option value="Delivered">Delivered</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>