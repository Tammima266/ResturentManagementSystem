@model ResturentManagementSystem1.Models.Category

@{
    ViewData["Title"] = "Add Category - Admin Dashboard";
}

<div class="container my-5" style="max-width: 600px;">
    <h2 class="mb-4">Add New Menu Category</h2>

    <form asp-action="CreateCategory" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Item Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Spicy Chicken Burger" required />
        </div>
        <div class="mb-3">
            <label asp-for="Price" class="form-label fw-bold">Price (BDT)</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="350" required />
        </div>
        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label fw-bold">Image URL</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." required />
        </div>
        <div class="d-flex justify-content-between mt-3">
            <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
            <button type="submit" class="btn btn-primary">Save Menu Item</button>
        </div>
    </form>
</div>
