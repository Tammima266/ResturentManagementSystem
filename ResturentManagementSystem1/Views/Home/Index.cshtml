@model IEnumerable<ResturentManagementSystem1.Models.Category>

@{
    ViewData["Title"] = "Home - FunFood Restaurant";
    var combos = ViewBag.Combos as IEnumerable<ResturentManagementSystem1.Models.Combo>;
}

<!-- Hero Banner Section -->
<div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center">
    <div class="container-fluid py-3">
        <h1 class="display-4 fw-bold text-danger">Welcome to FunFood 🍔</h1>
        <p class="col-md-8 fs-5 mx-auto text-muted">
            Delicious meals, gourmet burgers, and awesome combo deals delivered right to your door hot and fresh.
        </p>

        <!-- Quick Track Order Search Box (Only visible to logged-in customers, hidden for admins) -->
        @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
        {
            <div class="mt-4">
                <form asp-controller="Home" asp-action="TrackOrder" method="get" class="d-inline-flex justify-content-center align-items-center gap-2">
                    <input type="number" name="id" class="form-control form-control-sm w-auto" placeholder="Enter Order ID (e.g., 1)" required />
                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">Track Status 🔍</button>
                </form>
            </div>
        }
    </div>
</div>

<!-- Combos Section -->
@if (combos != null && combos.Any())
{
    <div id="combos" class="mb-5 pt-3">
        <h2 class="mb-4 fw-bold">Special Combos 🔥</h2>
        <div class="row">
            @foreach (var combo in combos)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@combo.ImageUrl" class="card-img-top" alt="@combo.Name" style="height: 200px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@combo.Name</h5>
                            <p class="card-text text-muted small">@combo.Subtitle</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success fs-5">৳@combo.Price.ToString("0.00")</span>
                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@combo.Id" class="btn btn-danger btn-sm">Order Combo 🛒</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Categories / Menu Items Section -->
<div class="mb-5">
    <h2 class="mb-4 fw-bold">Our Menu Categories 🍽️</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-success fs-5">৳@item.Price.ToString("0.00")</span>
                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Add to Cart 🛒</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>