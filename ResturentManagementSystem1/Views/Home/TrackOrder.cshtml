@model ResturentManagementSystem1.Models.Order

@{
    ViewData["Title"] = "Track Your Order - FunFood";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h3 class="mb-0 fw-bold">Live Order Tracker 🚚</h3>
                </div>
                <div class="card-body bg-light p-4">
                    
                    <div class="d-flex justify-content-between mb-4">
                        <div>
                            <h5 class="fw-bold text-dark">Order ID: #@Model.Id</h5>
                            <p class="text-muted mb-0">Customer: @Model.CustomerName</p>
                        </div>
                        <div class="text-end">
                            <h5 class="text-success fw-bold">৳@Model.TotalAmount.ToString("0.00")</h5>
                            <span class="badge bg-secondary">Status: @Model.OrderStatus</span>
                        </div>
                    </div>

                    <!-- Live Order Status Progress Navbar -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body">
                            <h6 class="text-uppercase text-muted fw-bold mb-3 small">Order Progress</h6>
                            
                            <nav class="nav nav-pills nav-fill flex-column flex-sm-row gap-2">
                                <!-- 1. Pending -->
                                <span class="nav-link @(Model.OrderStatus == "Pending" ? "active bg-warning text-dark fw-bold shadow" : "bg-white text-muted border")">
                                    1. Pending
                                </span>
                                
                                <!-- 2. Preparing -->
                                <span class="nav-link @(Model.OrderStatus == "Preparing" ? "active bg-info text-dark fw-bold shadow" : "bg-white text-muted border")">
                                    2. Preparing
                                </span>
                                
                                <!-- 3. Ready -->
                                <span class="nav-link @(Model.OrderStatus == "Ready" ? "active bg-success text-white fw-bold shadow" : "bg-white text-muted border")">
                                    3. Ready
                                </span>
                                
                                <!-- 4. Delivered -->
                                <span class="nav-link @(Model.OrderStatus == "Delivered" ? "active bg-success text-white fw-bold shadow" : "bg-white text-muted border")">
                                    4. Delivered
                                </span>
                            </nav>

                            <!-- Cancelled Alert view with Refund Notice -->
                            @if (Model.OrderStatus == "Cancelled")
                            {
                                <div class="alert alert-danger text-center mt-3 mb-0">
                                    <h5 class="fw-bold mb-1">❌ This order has been cancelled.</h5>
                                    <p class="small mb-0">Your payment will be refunded to your original payment method shortly.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Placed on: @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</span>
                        <a asp-action="Index" class="btn btn-outline-dark fw-bold">Back to Home</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>