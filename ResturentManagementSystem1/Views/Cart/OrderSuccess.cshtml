@{
    ViewData["Title"] = "Order Success - FunFood";
    var orderId = ViewBag.OrderId;
}

<div class="container text-center my-5">
    <div class="card p-5 shadow-sm mx-auto" style="max-width: 600px;">
        <h1 class="text-success mb-3">🎉 Order Placed Successfully!</h1>
        <p class="lead">Thank you for ordering with FunFood. Your payment via <strong>@ViewBag.PaymentMethod</strong> was processed successfully.</p>
        <p class="text-muted">Your order has been registered and is now being prepared fresh in our kitchen.</p>
        
        @if (orderId != null)
        {
            <div class="alert alert-light border py-3 my-3">
                <h6 class="text-muted mb-1">Your Order ID is:</h6>
                <h3 class="fw-bold text-danger mb-0">#@orderId</h3>
            </div>
        }

        <hr class="my-4">
        
        <div class="d-grid gap-2">
            @if (orderId != null)
            {
                <a asp-controller="Home" asp-action="TrackOrder" asp-route-id="@orderId" class="btn btn-danger btn-lg fw-bold">
                    Track Your Order Live 🚚
                </a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">Return to Menu Home</a>
        </div>
    </div>
</div>