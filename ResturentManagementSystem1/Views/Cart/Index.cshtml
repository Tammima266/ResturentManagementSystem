@model IEnumerable<ResturentManagementSystem1.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart - FunFood";
    decimal grandTotal = Model.Sum(item => item.Price * item.Quantity);
}

<div class="container my-5">
    <h2 class="mb-4">Your FunFood Cart 🛒</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            Your cart is empty. <a asp-controller="Home" asp-action="Index" class="alert-link">Browse our menu</a> and add some delicious items!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Item</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 60px; height: 60px; object-fit: cover;" class="me-3 rounded" />
                                    }
                                    <strong>@item.Name</strong>
                                </div>
                            </td>
                            <td>৳@item.Price.ToString("0.00")</td>
                            <td>
                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control d-inline-block text-center" style="width: 70px;" onchange="this.form.submit()" />
                                </form>
                            </td>
                            <td>৳@((item.Price * item.Quantity).ToString("0.00"))</td>
                            <td>
                                <a asp-action="RemoveFromCart" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4>Grand Total: <span class="text-success">৳@grandTotal.ToString("0.00")</span></h4>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">Continue Shopping</a>
                <a asp-action="Checkout" class="btn btn-success btn-lg">Proceed to Checkout</a>
            </div>
        </div>
    }
</div>