@model IEnumerable<ResturentManagementSystem1.Models.CartItem>

@{
    ViewData["Title"] = "Checkout - FunFood";
    decimal grandTotal = Model.Sum(item => item.Price * item.Quantity);
}

<div class="container my-5">
    <h2 class="mb-4">Secure Checkout 💳</h2>
    
    <div class="row">
        <div class="col-md-7">
            <h4>Order Summary</h4>
            <ul class="list-group mb-4">
                @foreach (var item in Model)
                {
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">@item.Name</h6>
                            <small class="text-muted">Quantity: @item.Quantity</small>
                        </div>
                        <span class="text-muted">৳@((item.Price * item.Quantity).ToString("0.00"))</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between bg-light">
                    <span><strong>Total (BDT)</strong></span>
                    <strong>৳@grandTotal.ToString("0.00")</strong>
                </li>
            </ul>
        </div>

        <div class="col-md-5">
            <h4>Select Payment Method</h4>
            <form asp-action="ProcessPayment" method="post" class="card p-3 bg-light">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="bKash" value="bKash" checked>
                    <label class="form-check-label fw-bold text-danger" for="bKash">
                        bKash Payment (Mobile Banking)
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="OnlineBanking" value="OnlineBanking">
                    <label class="form-check-label fw-bold text-primary" for="OnlineBanking">
                        Online Banking / Card Payment
                    </label>
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3">Confirm and Pay ৳@grandTotal.ToString("0.00")</button>
            </form>
        </div>
    </div>
</div>