<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FunFood</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand d-flex align-items-center fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="text-warning fs-3 me-2">🧑‍🍳</span>
                    <div>
                        <span class="text-warning" style="font-size: 1.4rem;">Fun</span><span class="text-dark" style="font-size: 1.4rem;">Food</span>
                        <div class="text-muted" style="font-size: 0.65rem; letter-spacing: 1px;">- TASTY & HUNGRY -</div>
                    </div>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" asp-controller="Cart" asp-action="Index">Cart 🛒</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold px-3" asp-controller="Admin" asp-action="Index">Admin Dashboard ⚙️</a>
                            </li>
                        }
                    </ul>
                    
                    <!-- Login / Register Partial -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Mild Reddish-Orange Footer with White Font Color & Proper Details -->
    <footer class="text-white pt-5 pb-3 mt-auto" style="background-color: #e65c00;">
        <div class="container">
            <div class="row">
                <!-- Brand Description Column -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-white fw-bold mb-3">FunFood 🍔</h5>
                    <p class="text-light small">
                        Serving mouth-watering gourmet burgers, crispy chicken buckets, artisan sandwiches, and awesome combo deals fresh, fast, and hot to your doorstep.
                    </p>
                </div>
                
                <!-- Contact Details & Helpline Column -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-white fw-bold mb-3">Customer Support & Helpline</h5>
                    <p class="text-light small mb-2">
                        <i class="fas fa-map-marker-alt text-warning me-2"></i> <strong>Address:</strong> House #42, Road #11, Block D, Banani, Dhaka-1213
                    </p>
                    <p class="text-light small mb-2">
                        <i class="fas fa-phone-alt text-warning me-2"></i> <strong>Hotline / Helpline:</strong> +880 9612-345678, +880 1700-987654
                    </p>
                    <p class="text-light small mb-0">
                        <i class="fas fa-envelope text-warning me-2"></i> <strong>Email:</strong> support@funfood.com
                    </p>
                </div>
                
                <!-- Social Media & Working Hours Column -->
                <div class="col-lg-4 col-md-12 mb-4">
                    <h5 class="text-white fw-bold mb-3">Opening Hours & Socials</h5>
                    <p class="text-light small mb-3">
                        <i class="fas fa-clock text-warning me-2"></i> Saturday – Friday: 10:00 AM – 11:30 PM
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="https://facebook.com" target="_blank" class="text-white text-decoration-none" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://instagram.com" target="_blank" class="text-white text-decoration-none" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="https://twitter.com" target="_blank" class="text-white text-decoration-none" title="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="https://youtube.com" target="_blank" class="text-white text-decoration-none" title="YouTube"><i class="fab fa-youtube"></i></a>
                        <a href="https://wa.me/8801700987654" target="_blank" class="text-white text-decoration-none" title="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            
            <hr class="border-light my-4 opacity-50">
            
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start text-light small">
                    &copy; 2026 FunFood Restaurant Management System. All rights reserved.
                </div>
                <div class="col-md-6 text-center text-md-end text-light small">
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-light me-3">Privacy Policy</a>
                    <a href="#" class="text-decoration-none text-light">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>